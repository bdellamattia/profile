# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key (server only, never exposed to the browser): console.anthropic.com
ANTHROPIC_API_KEY=

# Code your friends must enter to sign up. Leave empty to allow open sign up.
INVITE_CODE=

# Max AI photo scans per user per 24 h
NEXT_PUBLIC_DAILY_AI_LIMIT=25
